                <Button type="button" variant="ghost" size="sm" onClick={() => setEditCoupon(null)}>إلغاء</Button>
              </div>
            </Form>
          </ModalContent>
        </ModalOverlay>
      )}

      <Form onSubmit={handleAdd} style={{ marginBottom: 24 }}>
        <FieldGroup>
          <Label>الاسم</Label>
