  --color-dark-bg: #121212;
  --color-dark-text: #e0e0e0;
  --color-dark-card: #1e1e1e;
  --color-dark-link: #82b1ff;
  --color-dark-shadow: rgba(255, 255, 255, 0.05);
}

/*FONT Face */

@font-face {
  font-family: "Amiri";
  src: url("../public/assets/fonts/Vazirmatn-Regular.ttf");
}

/* ================================
     🌞 Light Mode Styles
     ================================ */
body {
  background-color: var(--color-background);
  color: var(--color-text);
  line-height: 1.6;
  font-family: "Amiri";
  overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  color: var(--color-heading);
}

a {
  color: var(--color-link);
  text-decoration: none;
}
a:hover {
  color: var(--color-link-hover);
  text-decoration: underline;
}

.button-primary {
  background-color: var(--color-primary);
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 5px;
  cursor: pointer;
}
.button-primary:hover {
  background-color: var(--color-primary-hover);
}

.alert-success {
  background-color: var(--color-success-bg);
  color: var(--color-success-text);
  border: 1px solid var(--color-success-border);
  padding: 10px;
  border-radius: 5px;
}

.alert-warning {
  background-color: var(--color-warning-bg);
  color: var(--color-warning-text);
  border: 1px solid var(--color-warning-border);
  padding: 10px;
  border-radius: 5px;
}

/* ================================
     🌙 Dark Mode Styles
     ================================ */
body.dark-mode {
  background-color: var(--color-dark-bg);
  color: var(--color-dark-text);
}

body.dark-mode a {
  color: var(--color-dark-link);
}

body.dark-mode .card {
  background-color: var(--color-dark-card);
  box-shadow: 0 2px 4px var(--color-dark-shadow);
}

body.dark-mode .button-primary {
  background-color: var(--color-dark-link);
  color: white;
}

/*OverLay of Modal*/
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 9999;
}

/* In global.css or index.css */
@media (max-width: 767px) {
  body {
    overflow-x: hidden !important;
  }
}

ul {
  list-style: none;
}

/* الحركات البصرية للأيقونات */
@keyframes fillPulseCart {
  0% {
    fill: #2563eb;
    opacity: 0.6;
  }
  100% {
    fill: #2563eb;
    opacity: 1;
  }
}

@keyframes fillPulseHeart {
  0% {
    fill: #ca4e4e;
    opacity: 0.6;
  }
  100% {
    fill: #ca4e4e;
    opacity: 1;
  }
}

.loading-icon-cart {
  animation: fillPulseCart 0.8s infinite ease-in-out;
}

.loading-icon-heart {
  animation: fillPulseHeart 0.8s infinite ease-in-out;
}
</file>

