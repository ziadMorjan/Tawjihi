  font-size: ${({ theme }) => theme.typography.fontSize.sm};
`;

function calcYAxisWidth(data, key = 'name') {
  if (!data?.length) return 120;
  const longest = Math.max(...data.map((d) => (d[key] || '').length));
  return Math.min(Math.max(longest * 6.5, 120), 200);
}

