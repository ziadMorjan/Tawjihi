                <Button type="button" variant="ghost" size="sm" onClick={() => setEditNews(null)}>إلغاء</Button>
              </div>
            </Form>
          </ModalContent>
        </ModalOverlay>
      )}

      <Form onSubmit={handleAdd} style={{ marginBottom: 24 }}>
