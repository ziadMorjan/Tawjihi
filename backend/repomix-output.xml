(async () => {
	const mode = process.argv[2];
	if (!mode || (mode !== '-d' && mode !== '-i')) {
		console.error(t('seeder.invalid_mode'));
		process.exit(-1);
	}
	try {
		if (mode === '-d') {
			await deleteData();
			process.exit(0);
		} else if (mode === '-i') {
			await seedAdmin();
			await seedUsers();
			await seedTeachers();
			await seedBranches();
			await seedSubjects();
			console.log(t('seeder.seeding_complete'));
			process.exit(0);
		}
	} catch (error) {
		console.error(t('seeder.error_in_seeding', { error }));
		process.exit(-1);
	}
})();
